# Copy to an ignored server-side .env.production; never commit actual secrets.
APP_DOMAIN=api.akeelaonline.tech
# Temporarily set true for mobile integration; false hides UI, JSON and assets.
SWAGGER_ENABLED=false
ACME_EMAIL=admin@example.com
POSTGRES_PASSWORD=
# URL-encode the same password used above; postgres is the Docker service hostname.
DATABASE_URL=postgresql://akeela:URL_ENCODED_PASSWORD@postgres:5432/akeela
DATABASE_SSL=false
# Exact frontend origins. Change these together with the domain values below.
CORS_ORIGINS=https://admin.akeelaonline.tech,https://restaurant.akeelaonline.tech,https://delivery.akeelaonline.tech
ADMIN_DOMAIN=admin.akeelaonline.tech
VENDOR_DOMAIN=restaurant.akeelaonline.tech
DELIVERY_DOMAIN=delivery.akeelaonline.tech
JWT_SECRET=
OTP_SECRET=
JWT_ISSUER=akeela-api
JWT_AUDIENCE=akeela-clients
# Primary SMTP provider (e.g. Resend on mail.akeelaonline.tech)
SMTP_NAME=resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=AKEELA <noreply@mail.akeelaonline.tech>

# Optional automatic failover SMTP provider (e.g. Brevo; inherits SMTP_FROM if blank)
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_SECURE=false
SMTP_FALLBACK_REQUIRE_TLS=true
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM=

# Optional additional failover SMTP providers (SMTP_FALLBACK_2_* through SMTP_FALLBACK_5_*)
SMTP_FALLBACK_2_HOST=
SMTP_FALLBACK_2_PORT=587
SMTP_FALLBACK_2_SECURE=false
SMTP_FALLBACK_2_REQUIRE_TLS=true
SMTP_FALLBACK_2_USER=
SMTP_FALLBACK_2_PASSWORD=
SMTP_FALLBACK_2_FROM=
SMTP_FALLBACK_3_HOST=
SMTP_FALLBACK_4_HOST=
SMTP_FALLBACK_5_HOST=

# PUBLIC_BASE_URL and IMAGE_STORAGE_PATH are set by production Compose.
# Release automation supplies API_IMAGE as an immutable GHCR digest.

# Company profile ID (not user ID). Empty disables order acceptance, not app startup.
DEFAULT_DELIVERY_COMPANY_ID=

# Optional Firebase Cloud Messaging (FCM HTTP v1) credentials for mobile push notifications.
# Provide all three together or leave all three blank to run push delivery in no-op mode.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# First startup only; existing Admin is never modified from these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_PHONE=
ADMIN_VERIFIED=true
