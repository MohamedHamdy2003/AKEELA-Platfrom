# Copy to an ignored server-side .env.production; never commit actual secrets.
APP_DOMAIN=api.akeelaonline.tech
# Temporarily set true for mobile integration; false hides UI, JSON and assets.
SWAGGER_ENABLED=false
ACME_EMAIL=admin@example.com
POSTGRES_PASSWORD=
# URL-encode the same password used above; postgres is the Docker service hostname.
DATABASE_URL=postgresql://akeela:URL_ENCODED_PASSWORD@postgres:5432/akeela
DATABASE_SSL=false
# Exact frontend origins. Change these together with the domain values below.
CORS_ORIGINS=https://admin.akeelaonline.tech,https://restaurant.akeelaonline.tech,https://delivery.akeelaonline.tech
ADMIN_DOMAIN=admin.akeelaonline.tech
VENDOR_DOMAIN=restaurant.akeelaonline.tech
DELIVERY_DOMAIN=delivery.akeelaonline.tech
JWT_SECRET=
OTP_SECRET=
JWT_ISSUER=akeela-api
JWT_AUDIENCE=akeela-clients
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PUBLIC_BASE_URL and IMAGE_STORAGE_PATH are set by production Compose.
# Release automation supplies API_IMAGE as an immutable GHCR digest.

# Company profile ID (not user ID). Empty disables order acceptance, not app startup.
DEFAULT_DELIVERY_COMPANY_ID=

# First startup only; existing Admin is never modified from these values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_PHONE=
ADMIN_VERIFIED=true
