meta {
  name: Delete category
  type: http
  seq: 4
}

delete {
  url: {{base_url}}/restaurant/categories/{{cat_id}}
  body: none
  auth: inherit
}

tests {
  test('Successful delete empty category', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().message).to.equal('Category deleted.');
  });
}

docs {
  Delete an empty owned category (containing zero products) and compact remaining display orders to 1..N.
}
