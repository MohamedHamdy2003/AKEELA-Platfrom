meta {
  name: Login
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const tokens = res.getBody().data.tokens;
    if (tokens && tokens.access_token && tokens.refresh_token) {
      bru.setVar('access_token', tokens.access_token);
      bru.setVar('refresh_token', tokens.refresh_token);
    }
  }
}

tests {
  test('Successful login', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Stores access and refresh tokens in memory after successful login.
}
