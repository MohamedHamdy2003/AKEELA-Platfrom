meta {
  name: Register customer
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "{{full_name}}",
    "email": "{{email}}",
    "password": "{{password}}",
    "phone": "{{phone}}"
  }
}

tests {
  test('Successful register customer', function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Creates a customer and sends an email OTP. Use an unused email/phone.
}
