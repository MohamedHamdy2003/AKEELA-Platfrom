meta {
  name: Forgot password
  type: http
  seq: 8
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}"
  }
}

tests {
  test('Successful forgot password', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Requests a password-reset email; response is intentionally generic.
}
