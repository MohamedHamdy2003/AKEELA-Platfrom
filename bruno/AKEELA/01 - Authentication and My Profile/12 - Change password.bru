meta {
  name: Change password
  type: http
  seq: 12
}

patch {
  url: {{base_url}}/me/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "{{new_password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar('access_token', '');
    bru.setVar('refresh_token', '');
  }
}

tests {
  test('Successful change password', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Requires the current password. Revokes all sessions. Update private API_PASSWORD and log in again.
}
