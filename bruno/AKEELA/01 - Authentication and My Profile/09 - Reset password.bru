meta {
  name: Reset password
  type: http
  seq: 9
}

post {
  url: {{base_url}}/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "otp": "{{reset_otp}}",
    "new_password": "{{new_password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar('access_token', '');
    bru.setVar('refresh_token', '');
  }
}

tests {
  test('Successful reset password', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Set `reset_otp` from the reset email and `new_password` in your Bruno environment. Update `password` afterward and log in again.
}
