meta {
  name: Make owned address default
  type: http
  seq: 4
}

put {
  url: {{base_url}}/customer/addresses/{{address_id}}/default
  body: none
  auth: inherit
}

tests {
  test('Successful make address default', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.is_default).to.equal(true);
  });
}

docs {
  Make an owned address the default address in a single atomic transaction. Unsets any previous default.
}
