meta {
  name: Update addon
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/restaurant/addons/{{addon_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "addon_name": "Extra Cheese",
    "addon_price": "12.00",
    "is_active": true
  }
}

tests {
  test('Successful update addon', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.addon_id).to.be.a('string');
  });
}

docs {
  Update addon name, price, or activity.
}
