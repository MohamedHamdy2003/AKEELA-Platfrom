meta {
  name: Read dashboard
  type: http
  seq: 2
}

get {
  url: {{base_url}}/restaurant/dashboard
  body: none
  auth: inherit
}

tests {
  test('Successful read restaurant dashboard', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.rest_id).to.be.a('string');
    expect(res.getBody().data.activation_status).to.be.a('string');
    expect(res.getBody().data.can_manage).to.be.a('boolean');
    expect(res.getBody().data.message).to.be.a('string');
  });
}

docs {
  Read restaurant activation status and whether management is allowed.
}
