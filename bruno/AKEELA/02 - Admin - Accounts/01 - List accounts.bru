meta {
  name: List accounts
  type: http
  seq: 1
}

get {
  url: {{base_url}}/admin/users?page=1&per_page=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 20
  ~role: Restaurant
  ~is_active: true
}

tests {
  test('Successful list accounts', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data).to.be.an('array');
  });
}

docs {
  List accounts with pagination. Filter optionally by role or login activity.
}
