meta {
  name: Get offer
  type: http
  seq: 7
}

get {
  url: {{base_url}}/restaurants/{{rest_id}}/offers/{{offer_id}}
  body: none
  auth: none
}

tests {
  test('Successful get offer', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.offer_id).to.be.a('string');
  });
}

docs {
  Read a single available (active, within sale window) offer. No authentication required.
}
