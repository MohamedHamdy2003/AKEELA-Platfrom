meta {
  name: Browse restaurant products
  type: http
  seq: 4
}

get {
  url: {{base_url}}/restaurants/{{rest_id}}/products?page=1&per_page=20
  body: none
  auth: none
}

params:query {
  page: 1
  per_page: 20
}

tests {
  test('Successful browse products', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.be.an('array');
  });
}

docs {
  Browse active products for a restaurant. Optionally filter by cat_id. No authentication required.
}
