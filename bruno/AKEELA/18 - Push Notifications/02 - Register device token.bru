meta {
  name: Register device token
  type: http
  seq: 2
}

put {
  url: {{base_url}}/me/device-tokens
  body: json
  auth: inherit
}

body:json {
  {
    "fcm_token": "fcm_example_device_token_0123456789abcdefghijklmnopqrstuvwxyz",
    "platform": "android",
    "device_label": "Samsung Galaxy S24"
  }
}

script:post-response {
  if (res.getStatus() === 200 && res.getBody()?.data?.token_id) {
    bru.setVar('token_id', res.getBody().data.token_id);
  }
}

tests {
  test("Successful response", function () { expect(res.getStatus()).to.equal(200); });
}
