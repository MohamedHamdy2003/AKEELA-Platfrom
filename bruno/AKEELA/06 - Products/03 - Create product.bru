meta {
  name: Create product
  type: http
  seq: 3
}

post {
  url: {{base_url}}/restaurant/products
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "cat_id": "100",
    "prod_name": "Burger",
    "prod_description": "Grilled beef burger",
    "prod_image_url": "https://example.com/burger.jpg",
    "price": "100.00",
    "is_active": true
  }
}

tests {
  test('Successful create product', function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.prod_id).to.be.a('string');
    expect(res.getBody().data.prod_name).to.equal('Burger');
  });
}

docs {
  Create a product in an owned category.
}
