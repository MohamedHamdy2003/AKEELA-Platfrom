meta {
  name: Delete product
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/restaurant/products/{{prod_id}}
  body: none
  auth: inherit
}

tests {
  test('Successful delete unlinked product', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().message).to.equal('Product deleted.');
  });
}

docs {
  Permanently delete an unlinked owned product (cat_id must be null). Cascades open cart items and product-addon links while preserving historical order item snapshots.
}
