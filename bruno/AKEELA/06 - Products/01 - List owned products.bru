meta {
  name: List owned products
  type: http
  seq: 1
}

get {
  url: {{base_url}}/restaurant/products?page=1&per_page=20&cat_id=100
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 20
  cat_id: 100
}

tests {
  test('Successful list products', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data).to.be.an('array');
  });
}

docs {
  List owned products; optionally filter by category.
}
