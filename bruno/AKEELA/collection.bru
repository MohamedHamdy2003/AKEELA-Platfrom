meta {
  type: collection
}

auth {
  mode: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  Implemented APIs only. Run requests individually; OTP codes are read manually from email.
  Select Local or Production, then fill your test account values directly in the Bruno environment panel (secret fields stay local to Bruno).
  Login and Refresh keep tokens in runtime variables only; do not save them to environment files.
}
