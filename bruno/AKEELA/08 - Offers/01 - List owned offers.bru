meta {
  name: List owned offers
  type: http
  seq: 1
}

get {
  url: {{base_url}}/restaurant/offers?page=1&per_page=20
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 20
}

tests {
  test('Successful list offers', function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data).to.be.an('array');
  });
}

docs {
  List owned offers for the authenticated restaurant, including inactive and expired ones.
}
