encode zstd gzip
header X-Content-Type-Options nosniff
handle /api/* {
	reverse_proxy api:3000
}
handle /socket.io/* {
	reverse_proxy api:3000
}
handle_path /images/* {
	root * /srv/images
	header Cache-Control "public, max-age=31536000, immutable"
	file_server
}
handle {
	reverse_proxy {args[0]}:8080
}
