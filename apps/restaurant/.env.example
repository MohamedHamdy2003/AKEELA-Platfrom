# Public browser configuration only. Include /api/v1; never add secrets.
# Empty uses the same origin, with a development-only Vite proxy to port 3000.
VITE_API_BASE_URL=/api/v1

# Optional map provider overrides. These are PUBLIC build-time settings.
# Keep the provider's required attribution; attribution HTML is developer-controlled.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
