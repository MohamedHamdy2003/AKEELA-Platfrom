NODE_ENV=development
SWAGGER_ENABLED=true
PORT=3000
DATABASE_URL=postgresql://akeela:local_password@localhost:15432/akeela
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
TRUST_PROXY=false
# Generate separate random values, each at least 32 characters. Never commit real keys.
JWT_SECRET=
OTP_SECRET=
JWT_ISSUER=akeela-api
JWT_AUDIENCE=akeela-clients
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_IP_LIMIT=60
AUTH_RATE_ACCOUNT_LIMIT=10
# Local Mailpit only. Set real SMTP values and require TLS for production.
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AKEELA <noreply@example.com>
# Optional automatic fallback SMTP provider (e.g. Brevo/Resend/Gmail; supports SMTP_FALLBACK_* and SMTP_FALLBACK_2_*..5_*)
# SMTP_FALLBACK_HOST=smtp-relay.brevo.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_SECURE=false
# SMTP_FALLBACK_REQUIRE_TLS=true
# SMTP_FALLBACK_USER=
# SMTP_FALLBACK_PASSWORD=
# SMTP_FALLBACK_FROM=AKEELA <noreply@mail.akeelaonline.tech>
# Dedicated disposable integration database only; never use the application DB here.
TEST_DATABASE_URL=postgresql://akeela:local_password@localhost:15432/akeela_auth_test

# Admin bootstrapping credentials (used by npm run create:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_PHONE=

# Company profile ID (not user ID). Empty disables order acceptance, not app startup.
DEFAULT_DELIVERY_COMPANY_ID=

# Public origin used for image URLs (without /api/v1 or trailing slash).
PUBLIC_BASE_URL=http://localhost:3000
# Optional absolute image directory; default is apps/api/storage/images in the checkout.

# Optional Firebase Cloud Messaging (FCM HTTP v1) service account credentials.
# Leave all three empty to run push delivery in no-op mode.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
