{
  "name": "akeela-api",
  "version": "0.1.0",
  "private": true,
  "description": "AKEELA restaurant ordering API - NestJS modular monolith",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/integration/*.js",
    "migration:run:prod": "typeorm migration:run -d dist/database/data-source.js",
    "create:admin": "ts-node src/commands/create-admin.ts",
    "create:admin:prod": "node dist/commands/create-admin.js",
    "smtp:check": "ts-node src/commands/check-smtp.ts",
    "smtp:check:prod": "node dist/commands/check-smtp.js"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/platform-socket.io": "12.5.0",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/websockets": "12.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
