{
  "name": "akeela",
  "version": "0.1.0",
  "private": true,
  "description": "AKEELA platform monorepo",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "build": "npm run build --workspace akeela-api --",
    "start": "npm run start --workspace akeela-api --",
    "start:dev": "npm run start:dev --workspace akeela-api --",
    "start:prod": "npm run start:prod --workspace akeela-api --",
    "typecheck": "npm run typecheck --workspace akeela-api --",
    "test": "npm run test --workspace akeela-api --",
    "test:integration": "npm run test:integration --workspace akeela-api --",
    "migration:show": "npm run migration:show --workspace akeela-api --",
    "migration:generate": "npm run migration:generate --workspace akeela-api --",
    "migration:run": "npm run migration:run --workspace akeela-api --",
    "migration:revert": "npm run migration:revert --workspace akeela-api --",
    "create:admin": "npm run create:admin --workspace akeela-api --",
    "create:admin:prod": "npm run create:admin:prod --workspace akeela-api --",
    "smtp:check": "npm run smtp:check --workspace akeela-api --",
    "smtp:check:prod": "npm run smtp:check:prod --workspace akeela-api --",
    "lint": "eslint apps/api/src apps/api/test scripts",
    "format": "prettier --write apps scripts docs deploy README.md AGENTS.md *.json *.yml .github/workflows .prettierrc.json",
    "format:check": "prettier --check apps scripts docs deploy README.md AGENTS.md *.json *.yml .github/workflows .prettierrc.json",
    "docs:check": "node scripts/check-docs.mjs",
    "bruno:check": "node scripts/check-bruno.mjs",
    "test:tools": "node --test scripts/*.test.mjs",
    "check:repo": "npm run lint && npm run format:check && npm run docs:check && npm run bruno:check && npm run test:tools",
    "check:api": "npm run typecheck && npm test && npm run build",
    "check": "npm run check:repo && npm run check:api",
    "setup:local": "node scripts/setup-local.mjs",
    "smoke:production": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@usebruno/lang": "0.41.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript-eslint": "8.72.2"
  }
}
