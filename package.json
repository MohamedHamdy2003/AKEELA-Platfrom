{
  "name": "akeela-api",
  "version": "0.1.0",
  "private": true,
  "description": "AKEELA modular monolith \u00e2\u20ac\u201d restaurant ordering API",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test scripts",
    "format": "prettier --write src test scripts docs README.md AGENTS.md *.json *.yml .prettierrc.json",
    "format:check": "prettier --check src test scripts docs README.md AGENTS.md *.json *.yml .prettierrc.json",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run docs:check && npm run bruno:check",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:show": "npm run typeorm -- migration:show -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "test:integration": "tsc -p tsconfig.test.json && node --test dist-test/test/integration/*.js",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "setup:local": "node scripts/setup-local.mjs",
    "create:admin": "ts-node src/commands/create-admin.ts",
    "create:admin:prod": "node dist/commands/create-admin.js",
    "smtp:check": "ts-node src/commands/check-smtp.ts",
    "smtp:check:prod": "node dist/commands/check-smtp.js",
    "bruno:check": "node scripts/check-bruno.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/typeorm": "12.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@usebruno/lang": "0.41.0",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
